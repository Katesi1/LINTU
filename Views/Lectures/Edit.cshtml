@model LectureEditViewModel
@{
    ViewData["Title"] = "Edit Lecture";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0 text-primary">
                        <i class="feather icon-edit me-2"></i>Edit Lecture
                    </h5>
                    <p class="text-muted mb-0">Update lecture information</p>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ClassRoomId" />
                        <input type="hidden" asp-for="FileUrl" />

                        <div class="mb-3">
                            <label asp-for="LessonId" class="form-label">Lesson</label>
                            <select asp-for="LessonId" asp-items="Model.LessonList" class="form-select">
                                <option value="">-- Select Lesson --</option>
                            </select>
                            <span asp-validation-for="LessonId" class="text-danger"></span>
                            <div class="form-text">Select the lesson this lecture belongs to</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Lecture Title</label>
                            <input asp-for="Title" class="form-control" placeholder="Enter lecture title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                            <div class="form-text">Give your lecture a clear and descriptive title</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description (Optional)</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                placeholder="Enter lecture description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <div class="form-text">Briefly describe what students will learn in this lecture</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Order" class="form-label">Display Order</label>
                            <input asp-for="Order" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Order" class="text-danger"></span>
                            <div class="form-text">Set the order in which this lecture appears in the lesson</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DurationMinutes" class="form-label">Duration (minutes)</label>
                            <input asp-for="DurationMinutes" class="form-control" type="number" min="1" />
                            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                            <div class="form-text">Estimated time to complete this lecture</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Content Type</label>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <input class="form-check-input content-type-radio" type="radio"
                                        asp-for="ContentType" id="videoUrl" value="@LectureContentType.VideoUrl" />
                                    <label class="form-check-label" for="videoUrl">
                                        <i class="feather icon-video me-1 text-danger"></i> Video URL
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input content-type-radio" type="radio"
                                        asp-for="ContentType" id="uploadedFile"
                                        value="@LectureContentType.UploadedFile" />
                                    <label class="form-check-label" for="uploadedFile">
                                        <i class="feather icon-file me-1 text-primary"></i> Upload File
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input content-type-radio" type="radio"
                                        asp-for="ContentType" id="textContent"
                                        value="@LectureContentType.TextContent" />
                                    <label class="form-check-label" for="textContent">
                                        <i class="feather icon-file-text me-1 text-success"></i> Text Content
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="ContentType" class="text-danger"></span>
                        </div>

                        <div id="videoUrlContent" class="content-type-section mb-3">
                            <label asp-for="VideoUrl" class="form-label">Video URL</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="feather icon-video text-danger"></i></span>
                                <input asp-for="VideoUrl" class="form-control"
                                    placeholder="Enter video URL (YouTube, Vimeo, etc.)" id="videoUrlInput" />
                                <button type="button" class="btn btn-outline-primary"
                                    id="previewVideoBtn">Preview</button>
                            </div>
                            <span asp-validation-for="VideoUrl" class="text-danger"></span>

                            <div class="form-text mb-2">
                                <strong>Supported formats:</strong>
                                <ul class="list-unstyled d-flex flex-wrap gap-3 small mt-1">
                                    <li><i class="feather icon-check text-success me-1"></i>YouTube
                                        (https://youtube.com/watch?v=...)</li>
                                    <li><i class="feather icon-check text-success me-1"></i>Vimeo
                                        (https://vimeo.com/...)</li>
                                    <li><i class="feather icon-check text-success me-1"></i>Google Drive
                                        (https://drive.google.com/file/d/...)</li>
                                    <li><i class="feather icon-check text-success me-1"></i>Direct MP4 links</li>
                                </ul>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.VideoUrl))
                            {
                                <div class="mt-2 mb-3">
                                    <span class="text-muted">Current video URL: </span>
                                    <a href="@Model.VideoUrl" target="_blank" class="text-primary">@Model.VideoUrl</a>
                                </div>
                            }

                            <div id="videoPreviewContainer" class="mt-3">
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0">Video Preview</h6>
                                    </div>
                                    <div class="card-body">
                                        <div id="videoPreview" class="ratio ratio-16x9">
                                            <!-- Video preview will be loaded here -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="uploadedFileContent" class="content-type-section mb-3">
                            <label asp-for="UploadedFile" class="form-label">Upload File</label>
                            @if (!string.IsNullOrEmpty(Model.FileUrl))
                            {
                                <div class="mb-2">
                                    <span class="text-muted">Current file: </span>
                                    <a href="@Model.FileUrl" target="_blank">@System.IO.Path.GetFileName(Model.FileUrl)</a>
                                </div>
                            }
                            <input asp-for="UploadedFile" class="form-control" type="file" />
                            <span asp-validation-for="UploadedFile" class="text-danger"></span>
                            <div class="form-text">Upload a new file to replace the current one (max 50MB)</div>
                        </div>

                        <div id="textContentSection" class="content-type-section mb-3">
                            <label asp-for="TextContent" class="form-label">Text Content</label>
                            <textarea asp-for="TextContent" class="form-control" rows="10"
                                placeholder="Enter lecture content"></textarea>
                            <span asp-validation-for="TextContent" class="text-danger"></span>
                            <div class="form-text">Enter the text content for this lecture</div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="ClassRooms" asp-action="Details" asp-route-id="@Model.ClassRoomId"
                                class="btn btn-outline-secondary">
                                <i class="feather icon-arrow-left me-2"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="feather icon-save me-2"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Hide the video preview container initially
            $('#videoPreviewContainer').hide();

            // Show/hide content type sections based on selected radio button
            $('.content-type-radio').change(function () {
                $('.content-type-section').hide();

                if ($(this).val() === '@((int)LectureContentType.VideoUrl)') {
                    $('#videoUrlContent').show();
                } else if ($(this).val() === '@((int)LectureContentType.UploadedFile)') {
                    $('#uploadedFileContent').show();
                } else if ($(this).val() === '@((int)LectureContentType.TextContent)') {
                    $('#textContentSection').show();
                }
            });

            // Trigger change event on page load to show the correct section
            $('.content-type-radio:checked').trigger('change');

            // Video preview functionality
            $('#previewVideoBtn').click(function () {
                var videoUrl = $('#videoUrlInput').val().trim();
                if (!videoUrl) {
                    alert('Please enter a video URL first');
                    return;
                }

                var embedHtml = '';

                // YouTube URL
                if (videoUrl.includes('youtube.com/watch') || videoUrl.includes('youtu.be/')) {
                    var videoId = '';

                    if (videoUrl.includes('youtube.com/watch')) {
                        videoId = new URL(videoUrl).searchParams.get('v');
                    } else if (videoUrl.includes('youtu.be/')) {
                        videoId = videoUrl.split('youtu.be/')[1].split('?')[0];
                    }

                    if (videoId) {
                        embedHtml = '<iframe width="100%" height="100%" src="https://www.youtube.com/embed/' +
                            videoId + '" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
                    }
                }
                // Vimeo URL
                else if (videoUrl.includes('vimeo.com/')) {
                    var vimeoId = videoUrl.split('vimeo.com/')[1].split('?')[0];
                    if (vimeoId) {
                        embedHtml = '<iframe src="https://player.vimeo.com/video/' + vimeoId +
                            '" width="100%" height="100%" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>';
                    }
                }
                // Google Drive URL
                else if (videoUrl.includes('drive.google.com/file/d/')) {
                    var fileId = videoUrl.match(/\/d\/(.+?)\//) || videoUrl.match(/id=(.+?)&/);
                    if (fileId && fileId[1]) {
                        embedHtml = '<iframe src="https://drive.google.com/file/d/' + fileId[1] +
                            '/preview" width="100%" height="100%" allow="autoplay" allowfullscreen></iframe>';
                    }
                }
                // Direct video file URL
                else if (videoUrl.match(/\.(mp4|webm|ogg)(\?.*)?$/i)) {
                    embedHtml = '<video width="100%" height="100%" controls><source src="' +
                        videoUrl + '">Your browser does not support the video tag.</video>';
                }
                // Other URL - try direct embed
                else {
                    embedHtml = '<iframe src="' + videoUrl +
                        '" width="100%" height="100%" frameborder="0" allowfullscreen></iframe>';
                }

                if (embedHtml) {
                    $('#videoPreview').html(embedHtml);
                    $('#videoPreviewContainer').show();
                } else {
                    alert('Could not generate preview for this URL format. Make sure it\'s a supported video URL.');
                }
            });

            // Show preview for existing video on page load
            if ($('#videoUrlInput').val().trim() && $('input[name="ContentType"]:checked').val() === '@((int)LectureContentType.VideoUrl)') {
                $('#previewVideoBtn').click();
            }
        });
    </script>
}

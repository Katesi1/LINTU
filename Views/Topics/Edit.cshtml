@model LMS.Data.Entities.Topic

@{
    ViewData["Title"] = "Chỉnh sửa chủ đề";
}

<div class="page-header">
    <div class="row align-items-end">
        <div class="col-lg-8">
            <div class="page-header-title">
                <div class="d-inline">
                    <h4>Chỉnh sửa chủ đề</h4>
                    <span>Điều chỉnh thông tin chủ đề</span>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="page-header-breadcrumb">
                <ul class="breadcrumb-title">
                    <li class="breadcrumb-item">
                        <a href="/"><i class="feather icon-home"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Chủ đề</a>
                    </li>
                    <li class="breadcrumb-item">Chỉnh sửa</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="row">
        <div class="col-md-12 col-xl-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="feather icon-edit-2 mr-1"></i> Chỉnh sửa chủ đề</h5>
                    <div class="card-header-right">
                        <ul class="list-unstyled card-option">
                            <li><i class="feather icon-maximize full-card"></i></li>
                        </ul>
                    </div>
                </div>
                <form asp-action="Edit" method="post">
                    <div class="card-block">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group row">
                            <label asp-for="Name" class="col-sm-3 col-form-label">Tên chủ đề</label>
                            <div class="col-sm-9">
                                <input asp-for="Name" class="form-control" placeholder="Nhập tên chủ đề" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <small class="form-text text-muted">Tên của chủ đề sẽ hiển thị cho người dùng.</small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="Alias" class="col-sm-3 col-form-label">Định danh</label>
                            <div class="col-sm-9">
                                <input asp-for="Alias" class="form-control" placeholder="Nhập định danh chủ đề" />
                                <span asp-validation-for="Alias" class="text-danger"></span>
                                <small class="form-text text-muted">Phiên bản thân thiện với URL của tên (không có
                                    khoảng trắng, ký tự đặc biệt, v.v.).</small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="ImageUrl" class="col-sm-3 col-form-label">URL hình ảnh</label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="feather icon-image"></i></span>
                                    </div>
                                    <input asp-for="ImageUrl" class="form-control"
                                        placeholder="https://example.com/image.jpg" />
                                </div>
                                <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                <small class="form-text text-muted">Liên kết đến hình ảnh đại diện cho chủ đề
                                    này.</small>

                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <div class="mt-3">
                                        <img src="@Model.ImageUrl" class="img-fluid img-thumbnail"
                                            style="max-height: 150px;" alt="Hình ảnh chủ đề hiện tại" />
                                        <p class="text-muted mt-1">Xem trước hình ảnh hiện tại</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between">
                            <div>
                                <a asp-action="Index" class="btn btn-outline-secondary waves-effect">
                                    <i class="feather icon-list mr-1"></i>Quay lại danh sách
                                </a>
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info waves-effect ml-2">
                                    <i class="feather icon-info mr-1"></i>Chi tiết
                                </a>
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">
                                <i class="feather icon-save mr-1"></i>Lưu thay đổi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="col-md-12 col-xl-4">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="feather icon-image mr-1"></i> Hình ảnh hiện tại</h5>
                    </div>
                    <div class="card-block">
                        <img src="@Model.ImageUrl" class="img-fluid img-thumbnail" alt="@Model.Name" />
                    </div>
                    <div class="card-footer bg-white">
                        <a href="@Model.ImageUrl" target="_blank" class="btn btn-outline-info btn-block waves-effect">
                            <i class="feather icon-external-link mr-1"></i>Xem kích thước đầy đủ
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

        function loadLessons() {
            const classRoomId = document.querySelector('input[name="ClassRoomId"]').value;
            if (!classRoomId) {
                console.error('No classroom ID found');
                return;
            }
            
            console.log('Loading lessons for classroom ID:', classRoomId);
            
            const accordion = document.getElementById('lessonsAccordion');
            if (!accordion) {
                console.error('Lessons accordion container not found');
                return;
            }
            
            // Show loading
            accordion.innerHTML = `
                <div class="text-center py-4">
                    <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                    <p>Loading lessons...</p>
                </div>
            `;
            
            // Fetch lessons
            $.ajax({
                url: '@Url.Action("GetLessons", "Lessons")',
                type: 'GET',
                data: { 
                    classRoomId: classRoomId
                },
                dataType: 'json',
                cache: false,
                success: function(response) {
                    console.log('GetLessons response:', response);
                    
                    // Clear accordion
                    accordion.innerHTML = '';
                    
                    // Clear lesson dropdown in the lecture creation modal
                    const dropdown = document.getElementById('lessonSelect');
                    if (dropdown) {
                        dropdown.innerHTML = '<option value="">Choose a lesson...</option>';
                    }
                    
                    // Check for successful response
                    if (!response.success) {
                        accordion.innerHTML = `
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                ${response.message || 'Failed to load lessons'}
                                <button class="btn btn-outline-danger mt-2" onclick="loadLessons()">
                                    <i class="fas fa-sync-alt me-1"></i> Try Again
                                </button>
                            </div>
                        `;
                        return;
                    }
                    
                    // Check if there are any lessons
                    const lessons = response.data || [];
                    if (lessons.length === 0) {
                        // No lessons message
                        accordion.innerHTML = `
                            <div class="text-center py-5">
                                <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                                <h5>No lessons yet</h5>
                                <p class="text-muted">Start building your course by creating lessons and adding lectures.</p>
                                @if (isAuthorized)
                                {
                                    <button class="btn btn-primary mt-2" data-toggle="modal" data-target="#lessonModal">
                                        <i class="fas fa-plus me-2"></i>Create your first lesson
                                    </button>
                                }
                            </div>
                        `;
                        return;
                    }
                    
                    // Add each lesson to the UI
                    lessons.forEach(function(lesson, index) {
                        const headingId = `heading-${lesson.id}`;
                        const collapseId = `collapse-${lesson.id}`;
                        
                        // Create the new lesson card
                        const lessonCard = document.createElement('div');
                        lessonCard.className = 'card border-0 shadow-sm mb-3';
                        lessonCard.setAttribute('data-lesson-id', lesson.id);
                        
                        const lectureCountText = lesson.lectureCount === 1 
                            ? '1 lecture' 
                            : `${lesson.lectureCount} lectures`;
                        
                        // HTML for the new lesson card
                        lessonCard.innerHTML = `
                            <div class="card-header bg-white p-0" id="${headingId}">
                                <div class="d-flex justify-content-between align-items-center p-3" 
                                    data-toggle="collapse" data-target="#${collapseId}" 
                                    aria-expanded="${index === 0 ? 'true' : 'false'}" aria-controls="${collapseId}" 
                                    style="cursor: pointer;">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3 text-primary">
                                            <i class="fas fa-layer-group fa-lg"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0 fw-bold">${lesson.title || 'Untitled Lesson'}</h5>
                                            <small class="text-muted">${lectureCountText} • ${lesson.totalDuration || 0} min total</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        @if (isAuthorized)
                                        {
                                            <div class="btn-group me-2">
                                                <a href="@Url.Action("Edit", "Lessons")/${lesson.id}" class="btn btn-sm btn-outline-primary" title="Edit Lesson">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", "Lessons")/${lesson.id}" class="btn btn-sm btn-outline-danger" title="Delete Lesson">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        }
                                        <i class="fas fa-chevron-down"></i>
                                    </div>
                                </div>
                            </div>
                            <div id="${collapseId}" class="collapse ${index === 0 ? 'show' : ''}" 
                                aria-labelledby="${headingId}" data-parent="#lessonsAccordion">
                                <div class="card-body pt-0">
                                    <!-- Lectures will be loaded here -->
                                    <div class="text-center py-3">
                                        <i class="fas fa-spinner fa-spin"></i>
                                        <p class="mb-0">Loading lectures...</p>
                                    </div>
                                </div>
                            </div>
                        `;
                        
                        // Add the new lesson card to the accordion
                        accordion.appendChild(lessonCard);
                        
                        // Add to dropdown in lecture creation modal
                        if (dropdown) {
                            const option = document.createElement('option');
                            option.value = lesson.id;
                            option.text = lesson.title || 'Untitled Lesson';
                            dropdown.appendChild(option);
                        }
                        
                        // Load lectures for this lesson
                        setTimeout(() => {
                            loadLectures(lesson.id);
                        }, 100); // Small delay to ensure the DOM is ready
                    });
                },
                error: function(xhr, status, error) {
                    console.error('Error loading lessons:', error);
                    console.error('Status:', status);
                    console.error('Response:', xhr.responseText);
                    
                    let errorMessage = 'Failed to load lessons. Network error or server unavailable.';
                    
                    accordion.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            ${errorMessage}
                            <button class="btn btn-outline-danger mt-2" onclick="loadLessons()">
                                <i class="fas fa-sync-alt me-1"></i> Try Again
                            </button>
                        </div>
                    `;
                }
            });
        }
        
        function loadLectures(lessonId) {
            if (!lessonId) {
                console.error('No lesson ID provided to loadLectures()');
                return;
            }

            console.log('Loading lectures for lesson ID:', lessonId);
            
            // Tìm lesson element dựa vào data-lesson-id
            const lessonElements = document.querySelectorAll(`[data-lesson-id="${lessonId}"]`);
            if (lessonElements.length === 0) {
                console.error(`Could not find element with data-lesson-id="${lessonId}"`);
                
                // Thử tìm dựa vào collapse ID
                const collapseElements = document.querySelectorAll(`.collapse`);
                let lessonElement = null;
                
                for (let i = 0; i < collapseElements.length; i++) {
                    const el = collapseElements[i];
                    const headingId = el.getAttribute('aria-labelledby');
                    if (headingId) {
                        const headingEl = document.getElementById(headingId);
                        if (headingEl) {
                            const parentCard = headingEl.closest('.card');
                            if (parentCard) {
                                lessonElement = parentCard;
                                break;
                            }
                        }
                    }
                }
                
                if (!lessonElement) {
                    showToast(`Không thể tìm thấy lesson với ID ${lessonId}`, "error");
                    return;
                }
            }
            
            const lessonElement = lessonElements[0] || document.querySelector(`.card:has([aria-labelledby="heading${lessonId}"])`);
            if (!lessonElement) {
                showToast(`Không thể tìm thấy lesson với ID ${lessonId}`, "error");
                return;
            }
            
            const collapseSection = lessonElement.querySelector('.card-body') || 
                                  lessonElement.querySelector('.collapse .card-body');
            
            if (!collapseSection) {
                console.error(`Could not find card-body within lesson ${lessonId}`);
                return;
            }
            
            // Show loading
            collapseSection.innerHTML = `
                <div class="text-center py-4">
                    <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                    <p>Đang tải bài giảng...</p>
                </div>
            `;
            
            // Fetch lectures
            $.ajax({
                url: '@Url.Action("GetLectures", "Lectures")',
                type: 'GET',
                data: { 
                    lessonId: lessonId
                },
                dataType: 'json',
                cache: false,
                success: function(response) {
                    console.log('GetLectures response:', response);
                    
                    // Kiểm tra cấu trúc dữ liệu phản hồi
                    if (typeof response !== 'object') {
                        collapseSection.innerHTML = `
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Phản hồi không hợp lệ từ máy chủ
                            </div>
                        `;
                        return;
                    }
                    
                    // Xây dựng lại giao diện
                    let headerHtml = `
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0 text-muted">Bài giảng</h6>
                            @if (isAuthorized)
                            {
                                <button class="btn btn-sm btn-outline-primary" 
                                    onclick="prepareAddLecture(${lessonId}, 'Lesson')" 
                                    data-toggle="modal" 
                                    data-target="#lectureModal">
                                    <i class="fas fa-plus me-1"></i> Thêm bài giảng
                                </button>
                            }
                        </div>
                    `;
                    
                    // Check if we have lectures
                    const lectures = response.data || [];
                    if (lectures.length === 0) {
                        // No lectures
                        collapseSection.innerHTML = headerHtml + `
                            <div class="text-center py-4">
                                <i class="fas fa-file-video fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">Chưa có bài giảng nào trong bài học này</p>
                                @if (isAuthorized)
                                {
                                    <button class="btn btn-sm btn-primary mt-2" 
                                        onclick="prepareAddLecture(${lessonId}, 'Lesson')" 
                                        data-toggle="modal" 
                                        data-target="#lectureModal">
                                        <i class="fas fa-plus me-2"></i>Thêm bài giảng
                                    </button>
                                }
                            </div>
                        `;
                        return;
                    }
                    
                    // Build the lectures list
                    let lecturesListHtml = `
                        ${headerHtml}
                        <ul class="list-group list-group-flush">
                    `;
                    
                    // Add each lecture
                    lectures.forEach(function(lecture) {
                        let iconClass = "text-info";
                        let icon = "fa-play-circle";
                        let contentType = "Video";
                        let actionButton = "";
                        
                        // Determine icon and action based on content type
                        if (lecture.contentType === 0 || lecture.contentType === "VideoUrl") {
                            iconClass = "text-info";
                            icon = "fa-play-circle";
                            contentType = "Video";
                            actionButton = `
                                <a href="@Url.Action("Watch", "Lectures")/${lecture.id}" class="btn btn-sm btn-primary" title="Watch">
                                    <i class="fas fa-play"></i> Xem
                                </a>
                            `;
                        } else if (lecture.contentType === 1 || lecture.contentType === "UploadedFile") {
                            iconClass = "text-warning";
                            icon = "fa-file-pdf";
                            contentType = "File";
                            actionButton = `
                                <a href="${lecture.fileUrl}" class="btn btn-sm btn-primary" title="Download" target="_blank">
                                    <i class="fas fa-download"></i> Tải xuống
                                </a>
                            `;
                        } else if (lecture.contentType === 2 || lecture.contentType === "TextContent") {
                            iconClass = "text-success";
                            icon = "fa-file-alt";
                            contentType = "Text";
                            actionButton = `
                                <a href="@Url.Action("Details", "Lectures")/${lecture.id}" class="btn btn-sm btn-primary" title="Read">
                                    <i class="fas fa-book-reader"></i> Đọc
                                </a>
                            `;
                        }
                        
                        // Append lecture item
                        lecturesListHtml += `
                            <li class="list-group-item px-0 py-3 border-0 ${lecture !== lectures[lectures.length - 1] ? "border-bottom" : ""}">
                                <div class="d-flex align-items-center">
                                    <div class="me-3 ${iconClass}">
                                        <i class="fas ${icon} fa-lg"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0">
                                            <a href="@Url.Action("Details", "Lessons")/${lecture.lessonId}" class="text-decoration-none text-dark">
                                                ${lecture.title}
                                            </a>
                                        </h6>
                                        <p class="text-muted small mb-1">${lecture.description || ''}</p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">${contentType} • ${lecture.durationMinutes} min</small>
                                            <div>
                                                @if (isAuthorized)
                                                {
                                                    <a href="@Url.Action("Edit", "Lectures")/${lecture.id}" class="btn btn-sm btn-outline-primary me-1" title="Edit Lecture">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("Delete", "Lectures")/${lecture.id}" class="btn btn-sm btn-outline-danger me-1" title="Delete Lecture">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                }
                                                <a href="@Url.Action("Details", "Lessons")/${lecture.lessonId}" class="btn btn-sm btn-primary me-1" title="View Lesson">
                                                    <i class="fas fa-eye"></i> View
                                                </a>
                                                ${actionButton}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        `;
                    });
                    
                    lecturesListHtml += `
                        </ul>
                    `;
                    
                    // Update the content
                    collapseSection.innerHTML = lecturesListHtml;
                    
                    // Update the lesson header with new lecture count and duration
                    updateLessonHeader(lessonId, lectures.length, lectures.reduce((total, l) => total + l.durationMinutes, 0));
                },
                error: function(xhr, status, error) {
                    console.error('Error loading lectures:', error);
                    console.error('Status:', status);
                    console.error('Response:', xhr.responseText);
                    
                    collapseSection.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Lỗi khi tải bài giảng: ${error || 'Lỗi không xác định'}
                            <button class="btn btn-sm btn-outline-danger mt-2" onclick="loadLectures(${lessonId})">
                                <i class="fas fa-sync-alt me-1"></i> Thử lại
                            </button>
                        </div>
                    `;
                }
            });
        }
        
        // Helper function to update lesson header with lecture info
        function updateLessonHeader(lessonId, lectureCount, totalMinutes) {
            // Tìm lesson element
            const lessonElement = document.querySelector(`[data-lesson-id="${lessonId}"]`) || 
                                document.querySelector(`.card:has([aria-labelledby="heading${lessonId}"])`);
            if (!lessonElement) return;
            
            // Tìm small text hiển thị thông tin lecture
            const lectureInfoEl = lessonElement.querySelector('small.text-muted');
            if (lectureInfoEl) {
                lectureInfoEl.textContent = `${lectureCount} bài giảng • ${totalMinutes} phút`;
            }
        }

        function toggleContentType() {
            // Hide all content type sections
            document.querySelectorAll('.content-type-section').forEach(section => {
                section.style.display = 'none';
            });
            
            // Show the selected section
            const contentType = document.querySelector('input[name="contentType"]:checked').value;
            

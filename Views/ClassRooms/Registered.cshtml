@model List<LMS.Models.ViewModels.RegisteredClassViewModel>

<div class="page-header">
    <div class="row align-items-end">
        <div class="col-lg-8">
            <div class="page-header-title">
                <div class="d-inline">
                    <h4><i class="feather icon-book text-primary mr-2"></i>Hành trình học tập của tôi</h4>
                    <span>Các lớp học bạn đã đăng ký để mở rộng kiến thức</span>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="page-header-breadcrumb">
                <ul class="breadcrumb-title d-inline-flex align-items-center m-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="feather icon-home"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="ClassRooms" asp-action="Registered">Đăng ký của tôi</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <!-- Statistics Row -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-blue text-white">
                <div class="card-block">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="text-white">@ViewBag.TotalItems</h4>
                            <h6 class="text-white m-b-0">Tổng số đăng ký</h6>
                        </div>
                        <div class="col-auto">
                            <i class="feather icon-book-open f-28"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-green text-white">
                <div class="card-block">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="text-white">@Model.Count(m => m.IsPaid)</h4>
                            <h6 class="text-white m-b-0">Khóa học đã thanh toán</h6>
                        </div>
                        <div class="col-auto">
                            <i class="feather icon-check-circle f-28"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-red text-white">
                <div class="card-block">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="text-white">@Model.Count(m => !m.IsPaid)</h4>
                            <h6 class="text-white m-b-0">Chờ thanh toán</h6>
                        </div>
                        <div class="col-auto">
                            <i class="feather icon-clock f-28"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-yellow text-white">
                <div class="card-block">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="text-white">@Model.Select(m => m.ClassRoom.Topic!.Name).Distinct().Count()</h4>
                            <h6 class="text-white m-b-0">Lĩnh vực học tập</h6>
                        </div>
                        <div class="col-auto">
                            <i class="feather icon-tag f-28"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="feather icon-list mr-2"></i>Lớp học đã đăng ký</h5>
                    <span class="text-muted">Tài liệu học tập của bạn ở một nơi</span>

                    <!-- Search Box in Header Right -->
                    <div class="card-header-right">
                        <form method="get" asp-controller="ClassRooms" asp-action="Registered"
                            class="search-bar-header">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Tìm kiếm lớp học..."
                                    name="searchQuery" value="@ViewBag.SearchQuery" autocomplete="off">
                                <div class="input-group-append">
                                    <button class="btn btn-primary waves-effect" type="submit">
                                        <i class="feather icon-search"></i>
                                    </button>
                                    @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
                                    {
                                        <a asp-controller="ClassRooms" asp-action="Registered"
                                            class="btn btn-outline-secondary waves-effect">
                                            <i class="feather icon-x"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card-block pb-0">
                    @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
                    {
                        <div class="alert alert-info mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="feather icon-info mr-2"></i>
                                    Hiển thị kết quả cho "<strong>@ViewBag.SearchQuery</strong>"
                                    (Tìm thấy @ViewBag.TotalItems @(ViewBag.TotalItems == 1 ? "kết quả" : "kết quả"))
                                </span>
                                <a asp-controller="ClassRooms" asp-action="Registered"
                                    class="btn btn-sm btn-outline-info waves-effect">
                                    <i class="feather icon-x"></i> Xóa tìm kiếm
                                </a>
                            </div>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="text-center p-5">
                            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
                            {
                                <i class="feather icon-search text-primary" style="font-size: 80px; opacity: 0.7;"></i>
                                <h4 class="mt-4 mb-2">Không tìm thấy kết quả</h4>
                                <p class="text-muted mb-4">Chúng tôi không tìm thấy lớp học nào phù hợp với tiêu chí tìm kiếm
                                    của bạn.</p>
                                <a asp-controller="ClassRooms" asp-action="Registered"
                                    class="btn btn-primary btn-lg waves-effect">
                                    <i class="feather icon-refresh-cw mr-1"></i> Xem tất cả lớp học
                                </a>
                            }
                            else
                            {
                                <i class="feather icon-book text-primary" style="font-size: 80px; opacity: 0.7;"></i>
                                <h4 class="mt-4 mb-2">Hành trình học tập của bạn đang chờ đợi</h4>
                                <p class="text-muted mb-4">Bạn chưa đăng ký lớp học nào. Hãy bắt đầu khám phá và nâng cao kỹ
                                    năng của mình!</p>
                                <a asp-controller="ClassRooms" asp-action="Index" class="btn btn-primary btn-lg waves-effect">
                                    <i class="feather icon-search mr-1"></i> Khám phá lớp học có sẵn
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var item in Model)
                            {
                                var classRoom = item.ClassRoom;
                                var isPaid = item.IsPaid;

                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card app-design hover-shadow-2"
                                        style="border-radius: 8px; overflow: hidden; transition: all 0.25s ease;">
                                        <div class="card-header @(isPaid ? "bg-gradient-success" : "bg-gradient-danger") text-white"
                                            style="border-radius: 0; padding: 15px 20px;">
                                            <h5 class="card-title text-white mb-0">@classRoom.Name</h5>
                                        </div>
                                        <div>
                                            <img src="@(!string.IsNullOrEmpty(classRoom.ImageUrl) ? classRoom.ImageUrl : "/img/default_course.png")"
                                                class="card-img-top" alt="Ảnh lớp học"
                                                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
                                                onerror="this.onerror=null; this.src='/img/default_course.png';">
                                            <div class="overlay-status position-absolute" style="top: 10px; right: 10px;">
                                                @if (isPaid)
                                                {
                                                    <span class="badge badge-pill badge-success px-3 py-2"><i
                                                            class="feather icon-check mr-1"></i>Đã thanh toán</span>
                                                }
                                                else if (classRoom.Price == 0)
                                                {
                                                    <span class="badge badge-pill badge-info px-3 py-2"><i
                                                            class="feather icon-gift mr-1"></i>Miễn phí</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-pill badge-danger px-3 py-2"><i
                                                            class="feather icon-alert-circle mr-1"></i>Chờ thanh toán</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="card-block p-4">
                                            <div class="row align-items-center mb-3">
                                                <div class="col-auto">
                                                    <span class="badge badge-light text-dark f-14 px-3 py-2"><i
                                                            class="feather icon-tag text-primary mr-1"></i>@classRoom.Topic!.Name</span>
                                                </div>
                                                <div class="col text-right">
                                                    <span class="text-muted"><i
                                                            class="feather icon-calendar text-primary mr-1"></i>@classRoom.CreateDate.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <p class="card-text text-muted" style="height: 48px; overflow: hidden;">
                                                @classRoom.Introduction</p>
                                            <div class="d-flex justify-content-between align-items-center mt-4">
                                                <div class="badge badge-light f-14 p-2 px-3" style="border-radius: 20px;">
                                                    <i class="feather icon-dollar-sign text-primary mr-1"></i>
                                                    <span class="f-w-600">@String.Format("{0:0,0} VND", classRoom.Price)</span>
                                                </div>
                                                @if (classRoom.Students > 0)
                                                {
                                                    <div class="badge badge-light f-14 p-2 px-3" style="border-radius: 20px;">
                                                        <i class="feather icon-users text-primary mr-1"></i>
                                                        <span>@classRoom.Students học viên</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="card-footer bg-light border-0 p-3">
                                            <div class="d-flex justify-content-between">
                                                @if (!isPaid)
                                                {
                                                    @if (classRoom.Price == 0)
                                                    {
                                                        <span class="text-info pt-2"><i class="feather icon-gift mr-1"></i>
                                                            Miễn phí</span>
                                                    }
                                                    else
                                                    {
                                                        <a href="#" class="btn btn-outline-primary btn-round btn-sm waves-effect">
                                                            <i class="feather icon-credit-card mr-1"></i> Thanh toán ngay
                                                        </a>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-success pt-2"><i class="feather icon-check-circle mr-1"></i>
                                                        Đã thanh toán</span>
                                                }
                                                <a asp-controller="ClassRooms" asp-action="Introduction"
                                                    asp-route-id="@classRoom.Id"
                                                    class="btn btn-primary btn-round btn-sm waves-effect">
                                                    <i class="feather icon-eye mr-1"></i> Xem lớp học
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        <nav class="mt-4 mb-3">
                            <div class="row">
                                <div class="col-md-6 d-flex align-items-center">
                                    <p class="m-0 text-muted">
                                        Hiển thị @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) đến
                                        @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems)) của
                                        @ViewBag.TotalItems kết quả
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <ul class="pagination pagination-primary justify-content-end m-0">
                                        @if (ViewBag.CurrentPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" asp-controller="ClassRooms" asp-action="Registered"
                                                    asp-route-page="1" asp-route-searchQuery="@ViewBag.SearchQuery">
                                                    <i class="feather icon-chevrons-left"></i>
                                                </a>
                                            </li>
                                            <li class="page-item">
                                                <a class="page-link" asp-controller="ClassRooms" asp-action="Registered"
                                                    asp-route-page="@(ViewBag.CurrentPage - 1)"
                                                    asp-route-searchQuery="@ViewBag.SearchQuery">
                                                    <i class="feather icon-chevron-left"></i>
                                                </a>
                                            </li>
                                        }

                                        @{
                                            int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                                            int endPage = Math.Min(ViewBag.TotalPages, startPage + 4);
                                            startPage = Math.Max(1, endPage - 4);
                                        }

                                        @for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                <a class="page-link" asp-controller="ClassRooms" asp-action="Registered"
                                                    asp-route-page="@i" asp-route-searchQuery="@ViewBag.SearchQuery">
                                                    @i
                                                </a>
                                            </li>
                                        }

                                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" asp-controller="ClassRooms" asp-action="Registered"
                                                    asp-route-page="@(ViewBag.CurrentPage + 1)"
                                                    asp-route-searchQuery="@ViewBag.SearchQuery">
                                                    <i class="feather icon-chevron-right"></i>
                                                </a>
                                            </li>
                                            <li class="page-item">
                                                <a class="page-link" asp-controller="ClassRooms" asp-action="Registered"
                                                    asp-route-page="@ViewBag.TotalPages"
                                                    asp-route-searchQuery="@ViewBag.SearchQuery">
                                                    <i class="feather icon-chevrons-right"></i>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-success {
        background: linear-gradient(45deg, #0ac282, #0df3a3);
    }

    .bg-gradient-danger {
        background: linear-gradient(45deg, #fe5d70, #fe909d);
    }

    .hover-shadow-2:hover {
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        transform: translateY(-3px);
    }

    .hover-shadow-2:hover .card-img-top {
        transform: scale(1.05);
    }

    .pagination-primary .page-item.active .page-link {
        background-color: #4099ff;
        border-color: #4099ff;
    }

    .waves-effect {
        position: relative;
        overflow: hidden;
        cursor: pointer;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .card {
        margin-bottom: 20px;
    }

    /* Improved search bar */
    .search-bar-header {
        min-width: 280px;
    }

    .search-bar-header .form-control {
        border-radius: 30px 0 0 30px;
        height: 38px;
        border-right: none;
        box-shadow: none;
        padding-left: 15px;
        transition: all 0.3s ease;
    }

    .search-bar-header .form-control:focus {
        border-color: #4099ff;
        box-shadow: 0 0 0 0.2rem rgba(64, 153, 255, 0.15);
    }

    .search-bar-header .input-group-append .btn {
        border-radius: 0 30px 30px 0;
        height: 38px;
        padding-left: 15px;
        padding-right: 15px;
    }

    .search-bar-header .input-group-append .btn-outline-secondary {
        border-left: none;
    }
</style>

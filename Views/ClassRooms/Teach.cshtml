@model List<LMS.Data.Entities.ClassRoom>

<div class="page-header">
    <div class="row align-items-end">
        <div class="col-lg-8">
            <div class="page-header-title">
                <div class="d-inline">
                    <h4>Lớp học của tôi</h4>
                    <span>Quản lý các lớp học đã tạo</span>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="page-header-breadcrumb">
                <ul class="breadcrumb-title d-inline-flex align-items-center m-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="feather icon-home"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="ClassRooms" asp-action="Teach">Lớp học</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>Danh sách lớp</h5>
                    <div class="card-header-right">
                        <a asp-controller="ClassRooms" asp-action="Create" class="btn btn-primary btn-round">
                            <i class="feather icon-plus"></i> Tạo lớp học mới
                        </a>
                    </div>
                </div>
                <div class="card-block">
                    @if (Model.Count == 0)
                    {
                        <div class="text-center p-4">
                            <i class="feather icon-book-open text-primary" style="font-size: 60px;"></i>
                            <h5 class="mt-3">Bạn chưa tạo lớp học nào</h5>
                            <p class="text-muted">Nhấn nút "Tạo lớp học mới" để bắt đầu</p>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var classRoom in Model)
                            {
                                <div class="col-md-4 mb-4">
                                    <div class="card app-design">
                                        <div class="card-header bg-c-@GetStatusColor(classRoom.Status) text-white">
                                            <h5 class="card-title text-white mb-0">@classRoom.Name</h5>
                                        </div>
                                        <div class="img-container" style="height: 80px; overflow: hidden;">
                                            <img src="@(string.IsNullOrEmpty(classRoom.ImageUrl) ? "/img/default_course.png" : classRoom.ImageUrl)" 
                                                class="card-img-top" alt="Ảnh lớp học"
                                                style="width: 100%; height: 100%; object-fit: cover;"
                                                onerror="this.onerror=null; this.src='/img/default_course.png';">
                                        </div>
                                        <div class="card-block">
                                            <div class="row align-items-center">
                                                <div class="col-auto">
                                                    <span class="badge badge-@GetStatusColor(classRoom.Status) m-0">@GetStatusText(classRoom.Status)</span>
                                                </div>
                                                <div class="col text-right">
                                                    <span class="text-muted f-w-400"><i class="feather icon-users"></i> @classRoom.Students Học viên</span>
                                                </div>
                                            </div>
                                            <p class="card-text mt-3 text-muted" style="height: 40px; overflow: hidden; text-overflow: ellipsis;">@classRoom.Introduction</p>
                                            <div class="mt-3">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="badge badge-light f-14"><i class="feather icon-tag"></i> @classRoom.Topic!.Name</span>
                                                    <h5 class="text-c-blue">@String.Format("{0:0,0} VND", classRoom.Price)</h5>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-footer bg-light">
                                            <div class="d-flex justify-content-between">
                                                <a asp-controller="ClassRooms" asp-action="Edit" asp-route-id="@classRoom.Id"
                                                    class="btn btn-outline-primary btn-sm">
                                                    <i class="feather icon-edit"></i> Sửa
                                                </a>
                                                <a asp-controller="ClassRooms" asp-action="Introduction" asp-route-id="@classRoom.Id"
                                                    class="btn btn-primary btn-sm">
                                                    <i class="feather icon-eye"></i> Xem
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        <nav class="mt-4">
                            <ul class="pagination justify-content-center">
                                @if (ViewBag.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Teach", new { page = ViewBag.CurrentPage - 1 })">
                                            <i class="feather icon-chevron-left"></i> Trước
                                        </a>
                                    </li>
                                }

                                <li class="page-item disabled">
                                    <span class="page-link">Trang @ViewBag.CurrentPage / @ViewBag.TotalPages</span>
                                </li>

                                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Teach", new { page = ViewBag.CurrentPage + 1 })">
                                            Tiếp <i class="feather icon-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusColor(ClassRoomStatus status)
    {
        return status switch
        {
            ClassRoomStatus.Pending => "warning",
            ClassRoomStatus.Approved => "success",
            _ => "info"
        };
    }
    
    string GetStatusText(ClassRoomStatus status)
    {
        return status switch
        {
            ClassRoomStatus.Pending => "Chờ duyệt",
            ClassRoomStatus.Approved => "Đã duyệt",
            _ => "Không xác định"
        };
    }
}
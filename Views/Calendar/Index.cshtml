@{
    ViewData["Title"] = "Lịch Học & Lịch Làm Việc";
}

<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title"><i class="feather icon-calendar mr-2"></i>Lịch Học & Sự Kiện</h3>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card mb-4 shadow-sm rounded-lg border-0">
            <div class="card-header bg-gradient-primary text-white rounded-top">
                <h5 class="card-title mb-0">Bộ Lọc</h5>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label>Chế độ xem</label>
                    <select class="form-control form-control-rounded" id="calendar-view">
                        <option value="dayGridMonth">Tháng</option>
                        <option value="timeGridWeek">Tuần</option>
                        <option value="timeGridDay">Ngày</option>
                        <option value="listWeek">Danh sách</option>
                    </select>
                </div>

                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="filter-lectures" checked>
                    <label class="custom-control-label d-flex align-items-center" for="filter-lectures">
                        <span class="badge badge-info rounded-circle mr-2">&nbsp;</span>
                        <span>Bài giảng</span>
                    </label>
                </div>

                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="filter-assignments" checked>
                    <label class="custom-control-label d-flex align-items-center" for="filter-assignments">
                        <span class="badge badge-success rounded-circle mr-2">&nbsp;</span>
                        <span>Bài tập</span>
                    </label>
                </div>

                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="filter-events" checked>
                    <label class="custom-control-label d-flex align-items-center" for="filter-events">
                        <span class="badge badge-primary rounded-circle mr-2">&nbsp;</span>
                        <span>Sự kiện</span>
                    </label>
                </div>

                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="filter-holidays" checked>
                    <label class="custom-control-label d-flex align-items-center" for="filter-holidays">
                        <span class="badge holiday-badge rounded-circle mr-2">&nbsp;</span>
                        <span>Ngày lễ</span>
                    </label>
                </div>

                <hr class="my-4">

                <button class="btn btn-primary btn-block rounded-pill shadow-sm" id="add-event-btn">
                    <i class="feather icon-plus"></i> Thêm sự kiện
                </button>
            </div>
        </div>

        <div class="card mb-4 shadow-sm rounded-lg border-0">
            <div class="card-header bg-gradient-info text-white rounded-top">
                <h5 class="card-title mb-0">Ghi chú</h5>
            </div>
            <div class="card-body small">
                <div class="d-flex align-items-center mb-3">
                    <span class="badge badge-info rounded-circle mr-2">&nbsp;</span>
                    <span>Bài giảng - Các buổi học trên hệ thống</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <span class="badge badge-success rounded-circle mr-2">&nbsp;</span>
                    <span>Bài tập - Hạn nộp các bài tập</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <span class="badge badge-primary rounded-circle mr-2">&nbsp;</span>
                    <span>Sự kiện - Các sự kiện khác</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <span class="badge holiday-badge rounded-circle mr-2">&nbsp;</span>
                    <span>Ngày lễ - Các ngày nghỉ lễ</span>
                </div>
                <div class="d-flex align-items-center">
                    <span class="badge badge-danger rounded-circle mr-2">&nbsp;</span>
                    <span>Lễ chính thức - Nghỉ lễ chính thức</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="card shadow-sm rounded-lg border-0">
            <div class="card-body p-0 rounded-lg overflow-hidden">
                <div id="calendar" class="p-3"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal thêm sự kiện -->
<div class="modal fade" id="event-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content rounded-lg shadow">
            <div class="modal-header bg-gradient-primary text-white">
                <h5 class="modal-title">Thêm sự kiện mới</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="event-form">
                    <div class="form-group">
                        <label for="event-title">Tiêu đề sự kiện</label>
                        <input type="text" class="form-control form-control-rounded" id="event-title" required>
                    </div>
                    <div class="form-group">
                        <label>Thời gian bắt đầu</label>
                        <input type="datetime-local" class="form-control form-control-rounded" id="event-start"
                            required>
                    </div>
                    <div class="form-group">
                        <label>Thời gian kết thúc</label>
                        <input type="datetime-local" class="form-control form-control-rounded" id="event-end" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill" id="save-event">Lưu sự kiện</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.0/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.0/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.0/locales/vi.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo đối tượng lịch
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                },
                locale: 'vi',
                editable: true,
                eventTimeFormat: {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                },
                themeSystem: 'bootstrap',
                events: '/Calendar/GetEvents',
                buttonText: {
                    today: 'Hôm nay',
                    month: 'Tháng',
                    week: 'Tuần',
                    day: 'Ngày',
                    list: 'Danh sách'
                },
                eventClick: function (info) {
                    if (info.event.url) {
                        info.jsEvent.preventDefault();
                        window.open(info.event.url, '_blank');
                    }
                },
                eventDidMount: function (info) {
                    // Thêm tooltip
                    if (info.event.extendedProps.description) {
                        $(info.el).tooltip({
                            title: info.event.extendedProps.description,
                            placement: 'top',
                            trigger: 'hover',
                            container: 'body'
                        });
                    }

                    // Áp dụng bộ lọc
                    if (info.event.extendedProps.type === 'lecture' && !$('#filter-lectures').prop('checked')) {
                        info.el.style.display = 'none';
                    }
                    if (info.event.extendedProps.type === 'assignment' && !$('#filter-assignments').prop('checked')) {
                        info.el.style.display = 'none';
                    }
                    if (info.event.extendedProps.type === 'event' && !$('#filter-events').prop('checked')) {
                        info.el.style.display = 'none';
                    }
                    if (info.event.extendedProps.type === 'holiday' && !$('#filter-holidays').prop('checked')) {
                        info.el.style.display = 'none';
                    }
                },
                dayCellDidMount: function (arg) {
                    // Kiểm tra nếu là ngày cuối tuần
                    if (arg.date.getDay() === 0 || arg.date.getDay() === 6) { // 0: Chủ Nhật, 6: Thứ 7
                        arg.el.classList.add('weekend-day');
                    }
                }
            });

            calendar.render();

            // Thêm icon cho nút Next và Previous
            setTimeout(function () {
                $('.fc-prev-button span').html('<i class="feather icon-chevron-left"></i>');
                $('.fc-next-button span').html('<i class="feather icon-chevron-right"></i>');
            }, 100);

            // Xử lý thay đổi chế độ xem
            $('#calendar-view').change(function () {
                calendar.changeView($(this).val());
            });

            // Xử lý thay đổi bộ lọc
            $('.custom-control-input').change(function () {
                calendar.refetchEvents();
            });

            // Xử lý thêm sự kiện mới
            $('#add-event-btn').click(function () {
                $('#event-modal').modal('show');

                // Thiết lập giá trị mặc định cho ngày giờ
                var now = new Date();
                var day = ("0" + now.getDate()).slice(-2);
                var month = ("0" + (now.getMonth() + 1)).slice(-2);
                var today = now.getFullYear() + "-" + month + "-" + day;
                var hour = ("0" + now.getHours()).slice(-2);
                var minute = ("0" + now.getMinutes()).slice(-2);
                var time = hour + ":" + minute;

                $('#event-start').val(today + "T" + time);
                $('#event-end').val(today + "T" + time);
            });

            // Lưu sự kiện mới
            $('#save-event').click(function () {
                var title = $('#event-title').val();
                var start = $('#event-start').val();
                var end = $('#event-end').val();

                if (title && start && end) {
                    $.ajax({
                        url: '/Calendar/SaveEvent',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            Title: title,
                            Start: new Date(start),
                            End: new Date(end)
                        }),
                        success: function (response) {
                            if (response.success) {
                                calendar.refetchEvents();
                                $('#event-modal').modal('hide');
                                $('#event-form')[0].reset();
                            }
                        }
                    });
                } else {
                    alert('Vui lòng điền đầy đủ thông tin');
                }
            });
        });
    </script>

    <style>
        /* Tùy chỉnh bo tròn và hiệu ứng */
        .rounded-lg {
            border-radius: 0.5rem !important;
        }

        .rounded-top {
            border-top-left-radius: 0.5rem !important;
            border-top-right-radius: 0.5rem !important;
        }

        .rounded-pill {
            border-radius: 50rem !important;
        }

        .form-control-rounded {
            border-radius: 0.5rem;
        }

        .shadow-sm {
            box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .075) !important;
        }

        /* Gradient màu */
        .bg-gradient-primary {
            background: linear-gradient(45deg, #4e73df, #6f86e0) !important;
        }

        .bg-gradient-info {
            background: linear-gradient(45deg, #36b9cc, #1cc8db) !important;
        }

        /* Màu gradient cho badges */
        .badge-success {
            background: linear-gradient(45deg, #1cc88a, #20e3a0) !important;
        }

        /* Màu cho ngày lễ */
        .holiday-badge {
            background: linear-gradient(45deg, #fd7e14, #f4a261) !important;
        }

        /* Ngày cuối tuần */
        .weekend-day {
            background-color: #f8f9fc !important;
        }

        /* Lớp cho sự kiện ngày lễ */
        .holiday-event {
            opacity: 0.7 !important;
        }

        /* FullCalendar tuỳ chỉnh */
        .fc-theme-bootstrap a {
            text-decoration: none !important;
        }

        .fc .fc-daygrid-day-top {
            flex-direction: row !important;
            padding: 5px !important;
        }

        .fc .fc-daygrid-day-number {
            padding: 2px 5px !important;
            border-radius: 50% !important;
            width: 25px;
            height: 25px;
            text-align: center;
            line-height: 21px;
        }

        .fc .fc-day-today .fc-daygrid-day-number {
            background-color: #4e73df !important;
            color: white !important;
        }

        /* Màu đen cho các ngày trong tuần */
        .fc-col-header-cell-cushion {
            color: #000000 !important;
            font-weight: 600 !important;
        }

        /* Nút previous và next */
        .fc .fc-button-primary {
            background-color: #4e73df !important;
            border-color: #4e73df !important;
            border-radius: 0.3rem !important;
        }

        .fc .fc-button-primary:hover {
            background-color: #2e59d9 !important;
            border-color: #2e59d9 !important;
        }

        .fc .fc-button-primary:disabled {
            background-color: #6f86e0 !important;
            border-color: #6f86e0 !important;
        }

        /* Icon trong nút */
        .fc-prev-button span,
        .fc-next-button span {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .fc-icon-chevron-left:before,
        .fc-icon-chevron-right:before {
            font-family: 'feather' !important;
        }

        .fc-event {
            cursor: pointer;
            border-radius: 0.3rem !important;
            padding: 2px 5px !important;
            font-size: 0.85em !important;
            border: none !important;
            margin: 1px 0 !important;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .fc-event:hover {
            transform: translateY(-1px) !important;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
            z-index: 100 !important;
        }

        .fc-col-header-cell {
            background-color: #f8f9fc !important;
            padding: 8px 0 !important;
        }

        .fc-view-harness {
            background-color: white !important;
            border-radius: 0.3rem !important;
            overflow: hidden !important;
        }

        /* Tùy chỉnh badge */
        .badge {
            display: inline-block !important;
            width: 20px !important;
            height: 20px !important;
            border-radius: 50% !important;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1) !important;
        }

        .fc-toolbar-chunk {
            display: flex !important;
            align-items: center !important;
        }

        .fc .fc-toolbar {
            flex-wrap: wrap !important;
            padding: 0.5rem !important;
        }
    </style>
}